# Vindicate local development defaults
# Never commit real secrets to this file.

# Shared runtime-worker authentication (minimum 32 characters)
VINDICATE_INTERNAL_KEY=change-me-to-at-least-32-characters-long

# Local services
VINDICATE_MCP_PORT=9223
VINDICATE_WORKER_PORT=9121
VINDICATE_WORKER_URL=http://127.0.0.1:9121

# MCP project scope
VINDICATE_PROJECT_ROOT=.

# Logging
LOG_LEVEL=info
# VINDICATE_LOG_FILE=.vindicate/logs/runtime.log
