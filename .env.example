# Vindicate Platform v2 - local development defaults
# Never commit real secrets to this file.

VINDICATE_ENV=development
VINDICATE_LOG_LEVEL=info

# Control API
CONTROL_API_BASE_URL=https://api.vindicate.example

# OAuth / OIDC (example placeholders)
VINDICATE_OAUTH_CLIENT_ID=replace-me
VINDICATE_OAUTH_ISSUER=https://auth.vindicate.example

# Runtime local ports
VINDICATE_RUNTIME_MCP_PORT=9120
VINDICATE_RUNTIME_WORKER_PORT=9121
