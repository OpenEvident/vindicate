{
  "id": "R07-auth-secret-in-step-value",
  "description": "Regression: validate rejects credentials baked into step fill value fields.",
  "tags": ["regression", "auth", "validate", "ai-schema"],
  "project": { "scaffold": "minimal" },
  "steps": [
    {
      "input": {
        "mode": "validate",
        "validateTarget": "create",
        "feature": "auth",
        "schema": {
          "pages": [
            {
              "feature": "auth",
              "page_class": "LoginPage",
              "path": "/login",
              "owned_by": "auth",
              "elements": [
                { "ref": "emailInput", "tag": "input", "testid": "email", "testid_attr": "e2e" },
                {
                  "ref": "passwordInput",
                  "tag": "input",
                  "testid": "password",
                  "testid_attr": "e2e"
                },
                { "ref": "loginButton", "tag": "button", "testid": "login", "testid_attr": "e2e" }
              ],
              "types": [],
              "steps": [
                {
                  "name": "step_login_with_credentials",
                  "jsdoc": "Sign in",
                  "params": [],
                  "actions": [
                    { "do": "fill", "ref": "emailInput", "value": "user@example.com" },
                    { "do": "fill", "ref": "passwordInput", "value": "SecretPass123" },
                    { "do": "click", "ref": "loginButton" }
                  ]
                }
              ],
              "verifies": []
            }
          ],
          "spec": {
            "suite": "Auth",
            "generates_storage_state": null,
            "storage_state": null,
            "before_each": null,
            "cases": [
              {
                "ac_id": "AC-1",
                "scenario": "Valid Login",
                "title": "[AC-1] should sign in",
                "body": [{ "fixture": "loginPage", "call": "step_login_with_credentials" }]
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "ok": true,
    "validate": {
      "valid": false,
      "errorCountMin": 1,
      "codesInclude": ["secret_in_step_value"]
    },
    "filesNotExist": ["pages/LoginPage.ts"]
  }
}
