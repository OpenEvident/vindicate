{
  "id": "S08-role-and-testid-mix",
  "description": "Mixed locator strategies on one page.",
  "tags": ["practical", "locator-strategy"],
  "project": { "scaffold": "minimal" },
  "steps": [
    {
      "input": {
        "mode": "create",
        "feature": "reports",
        "schema": {
          "pages": [
            {
              "feature": "reports",
              "page_class": "ReportsPage",
              "path": "/reports",
              "owned_by": "reports",
              "elements": [
                {
                  "ref": "startDate",
                  "tag": "input",
                  "testid": "start-date",
                  "testid_attr": "data-testid"
                },
                { "ref": "statusBanner", "tag": "div", "role": "status", "name": "Report ready" },
                { "ref": "runButton", "tag": "button", "role": "button", "name": "Run report" },
                { "ref": "heading", "tag": "h1", "name": "Reports" }
              ],
              "types": [],
              "steps": [
                {
                  "name": "step_navigate",
                  "jsdoc": "Open reports",
                  "params": [],
                  "actions": [{ "do": "navigate" }]
                },
                {
                  "name": "step_run",
                  "jsdoc": "Run report",
                  "params": [],
                  "actions": [{ "do": "click", "ref": "runButton" }]
                }
              ],
              "verifies": [
                {
                  "name": "verify_reportReady",
                  "jsdoc": "Report ready",
                  "params": [],
                  "assertions": [
                    {
                      "subject": "element",
                      "ref": "statusBanner",
                      "waitFor": "visible",
                      "matcher": "toContainText",
                      "arg": "expected.reportReadyText"
                    },
                    { "subject": "element", "ref": "heading", "matcher": "toBeVisible" }
                  ]
                }
              ]
            }
          ],
          "expected": {
            "reportReadyText": "Report ready"
          },
          "spec": {
            "suite": "App - Reports",
            "generates_storage_state": null,
            "storage_state": null,
            "before_each": null,
            "cases": [
              {
                "ac_id": "AC-77",
                "scenario": "Run report",
                "title": "[AC-77] should run report",
                "body": [
                  { "fixture": "reportsPage", "call": "step_navigate" },
                  { "fixture": "reportsPage", "call": "step_run" },
                  { "fixture": "reportsPage", "call": "verify_reportReady" }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "ok": true,
    "filesExist": ["pages/ReportsPage.ts", "tests/reports.spec.ts"],
    "mustContain": {
      "pages/ReportsPage.ts": [
        "locator-helper: testid",
        "locator-helper: role_name",
        "locator-helper: text",
        "waitFor({ state: 'visible' });"
      ]
    },
    "invariants": ["I1", "I2", "I3", "I4", "I6", "I9"],
    "compile": true
  }
}
