{
  "id": "S06-before-each-hooks",
  "description": "Spec generation with before_each flow calls.",
  "tags": ["practical", "spec"],
  "project": { "scaffold": "minimal" },
  "steps": [
    {
      "input": {
        "mode": "create",
        "feature": "search",
        "schema": {
          "pages": [
            {
              "feature": "search",
              "page_class": "SearchPage",
              "path": "/search",
              "owned_by": "search",
              "elements": [
                { "ref": "query", "tag": "input", "testid": "query", "testid_attr": "data-testid" },
                { "ref": "submit", "tag": "button", "role": "button", "name": "Search" }
              ],
              "types": [],
              "steps": [
                {
                  "name": "step_navigate",
                  "jsdoc": "Open search",
                  "params": [],
                  "actions": [{ "do": "navigate" }]
                },
                {
                  "name": "step_submit",
                  "jsdoc": "Submit query",
                  "params": [],
                  "actions": [{ "do": "click", "ref": "submit" }]
                }
              ],
              "verifies": [
                {
                  "name": "verify_searchReady",
                  "jsdoc": "Search page is ready",
                  "params": [],
                  "assertions": [{ "subject": "element", "ref": "query", "matcher": "toBeVisible" }]
                }
              ]
            }
          ],
          "spec": {
            "suite": "App - Search",
            "generates_storage_state": null,
            "storage_state": null,
            "before_each": [
              { "fixture": "searchPage", "call": "step_navigate" },
              { "fixture": "searchPage", "call": "verify_searchReady" }
            ],
            "cases": [
              {
                "ac_id": "AC-8",
                "scenario": "Query submitted",
                "title": "[AC-8] should submit query",
                "body": [{ "fixture": "searchPage", "call": "step_submit" }]
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "ok": true,
    "filesExist": ["tests/search.spec.ts", "pages/SearchPage.ts"],
    "mustContain": {
      "tests/search.spec.ts": [
        "test.beforeEach(async ({ searchPage }) => {",
        "await searchPage.step_navigate();",
        "await searchPage.verify_searchReady();"
      ]
    },
    "invariants": ["I1", "I2", "I6", "I10"],
    "compile": true
  }
}
