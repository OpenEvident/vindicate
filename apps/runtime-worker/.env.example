# Copy to .env.local and fill values (demo/smoke/dev use a built-in dev key if unset).

# Required for production — shared secret for runtime-mcp → worker (min 32 chars)
VINDICATE_INTERNAL_KEY=change-me-to-at-least-32-characters-long

# Server
VINDICATE_WORKER_PORT=9121

# Sessions
VINDICATE_SESSION_ENCRYPT=false
VINDICATE_SESSION_TTL_HOURS=24
VINDICATE_SESSION_CLEANUP_INTERVAL_MS=3600000
VINDICATE_SESSION_PAUSED_TTL_MINUTES=30

# Files + output
VINDICATE_MAX_FILE_BYTES=1048576
VINDICATE_MAX_OUTPUT_CHARS=50000

# Snapshots + settle
VINDICATE_SNAPSHOT_MAX_NODES=500
VINDICATE_SNAPSHOT_MAX_HTML_BYTES=102400
VINDICATE_SETTLE_NETWORK_MS=5000
VINDICATE_SETTLE_DOM_MS=3000
VINDICATE_SETTLE_TIMEOUT_MS=10000
VINDICATE_ACTION_TIMEOUT_MS=30000
VINDICATE_DELTA_CACHE_SIZE=5

# Logging + buffers
LOG_LEVEL=info
VINDICATE_CONSOLE_BUFFER_SIZE=500
VINDICATE_NETWORK_BUFFER_SIZE=500
VINDICATE_ACTION_LOG_SIZE=1000

# Resource governor
VINDICATE_MAX_CPU_PCT=80
VINDICATE_MAX_MEMORY_PCT=75
VINDICATE_REJECT_CPU_PCT=95
VINDICATE_REJECT_MEMORY_PCT=90

# Events ring buffer (worker → MCP push channel)
VINDICATE_EVENTS_BUFFER_SIZE=200
