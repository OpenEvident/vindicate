{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/extension/**/*.ts", "src/shared/**/*.ts"]
}
